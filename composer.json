{
    "name": "simplix-innovations/simplixpay-upayments",
    "description": "Development quality toolchain for SimplixPay for UPayments.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": ">=7.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "autoload": {
        "psr-4": {
            "Simplix\\Pay\\UPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simplix\\Pay\\UPayments\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "test:unit": "phpunit --configuration phpunit.xml.dist",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=512M",
        "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
        "quality": [
            "@test:unit",
            "@analyse",
            "@lint:phpcs"
        ]
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
